{
    "name": "Closest Point",
    "drawer": "scatter",
    "algorithm_type": "search",
    "description": "This algorithm search the closest point in a graph from a certain main point",
    "waiting_time": 0.1,
    "time_complexity": "O(N)",
     "generator": {
         "name": "r_dimension",
         "args": {
             "length": 30,
             "create_value": true,
             "dataset_unique": true
             }
     },
    "send_value_to_draw": true,
    "return_name": ["Closest Point", "Distance"],
    "value_name": "Main Point",
    "steps": {
        "search_randomly": [1, "Search every point randomly."],
        "if_lower": [2, "If the point distance to the main point is smaller than the previous distance."],
        "set": [3, "Set this point as the target and save its distance"]
        }
}